# ==========================================
# FastAPI / Python Standard GitIgnore
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments (Always ignore local dependencies)
.venv/
venv/
env/
ENV/
pyenv/
.python-version

# Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
secrets.toml

# Testing & Code Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
.tox/
.nox/

# Database files (Local development)
*.db
*.sqlite3

# Logs & Debugging
*.log
pip-log.txt
cherrypy.log

# Build & Packaging outputs
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==========================================
# IDEs & Editor Configurations
# ==========================================

# VS Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/

# OS generated files
.DS_Store
.DS_Store?
Thumbs.db
